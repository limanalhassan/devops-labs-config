# DevOps Labs config.
# Copy this file to `.env` next to `compose.yaml`, then fill in the values.

# The license key you were emailed, one long string starting with eyJ...
# Keep this file out of git, Slack, email, and any shared folder.
DEVOPS_LABS_LICENSE_KEY=

# The port on your machine where the UI is served. Change if 8090 is taken.
DEVOPS_LABS_PORT=8090

# Image version. Defaults to `0` (floating major). Pin to a hard version like
# `0.1.3` for strict upgrade control. See the README for guidance.
# DEVOPS_LABS_VERSION=0
