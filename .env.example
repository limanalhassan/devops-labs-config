# DevOps Labs config.
# Fill in the two REQUIRED values below (your license key and your pull token).
# Everything else is optional and already has a sensible default.
# When done, save this file as `.env` (same folder) and run the installer.

# =============================================================================
# REQUIRED: your license key.
# One long string starting with eyJ... from the welcome email you were sent.
# Paste it on one line, no quotes, no spaces.
DEVOPS_LABS_LICENSE_KEY=

# REQUIRED: your container registry pull token.
# One long string starting with github_pat_... from the same welcome email.
# This lets your machine pull the Docker images from the private registry.
GHCR_TOKEN=

# =============================================================================
# OPTIONAL: port on YOUR machine where the DevOps Labs UI will be served.
# Default is 8090. Change if 8090 is already in use (try 9090 or 8099).
DEVOPS_LABS_PORT=8090

# OPTIONAL: where DevOps Labs installs itself.
# Default is $HOME/devops-labs on macOS/Linux, %USERPROFILE%\devops-labs on Windows.
# Uncomment and change only if you have a specific reason.
# DEVOPS_LABS_HOME=

# OPTIONAL: image version to run.
# Default `0` (floating major): you get patch and minor upgrades automatically.
# Pin to a hard version like `0.1.3` for strict upgrade control.
# DEVOPS_LABS_VERSION=0
